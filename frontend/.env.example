# App
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=verify-full

# Base
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_CONTRACT_ADDRESS=0x...
PRIVATE_KEY=              # server-side only, never commit

# Africa's Talking
AT_USERNAME=sandbox
AT_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=

# Weather
WEATHER_API_KEY=

# SMS (optional)
AFRICASTALKING_BASE_URL=https://api.sandbox.africastalking.com

# Pretium (local payments)
PRETIUM_BASE_URL=https://api.xwift.africa
PRETIUM_API_KEY=
PRETIUM_SECRET_KEY=
PRETIUM_CHECKOUT_KEY=
PRETIUM_MERCHANT_ID=

# Demo / Pretium
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
PRETIUM_CALLBACK_SECRET=

# SMS provider switch: africastalking (default) | thrivevas
SMS_PROVIDER=thrivevas
THRIVEVAS_BASE_URL=https://sms.thrivevas.com
THRIVEVAS_SENDER_ID=ThriveVas
THRIVEVAS_MSISDN=
THRIVEVAS_PASSWORD=
THRIVEVAS_API_KEY=
